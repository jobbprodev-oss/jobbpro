NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Asaas - IMPORTANTE: URL e chave devem ser SEMPRE do mesmo ambiente.
#
# Produção (uso em produção/LIVE):
#   ASAAS_API_URL=https://api.asaas.com/v3
#   ASAAS_API_KEY=$aact_prod_xxxxxxxxxxxxxxxxxxxx
#
# Sandbox (uso apenas em desenvolvimento/testes):
#   ASAAS_API_URL=https://api-sandbox.asaas.com/v3
#   ASAAS_API_KEY=$aact_hmlg_xxxxxxxxxxxxxxxxxxxx
#
# Nunca misture URL de um ambiente com chave do outro.
# No painel de deploy (ex.: Vercel), confira se a variável de PRODUÇÃO
# está configurada com os valores de produção acima, e não os de Sandbox.
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=your_asaas_api_key_here
